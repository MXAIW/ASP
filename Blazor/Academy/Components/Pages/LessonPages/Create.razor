@page "/lessons/create"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Lesson</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Lesson" OnValidSubmit="AddLesson" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="group" class="form-label">group:</label> 
                <InputNumber id="group" @bind-Value="Lesson.group" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Lesson.group" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="discipline" class="form-label">discipline:</label> 
                <InputNumber id="discipline" @bind-Value="Lesson.discipline" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Lesson.discipline" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="teacher" class="form-label">teacher:</label> 
                <InputNumber id="teacher" @bind-Value="Lesson.teacher" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Lesson.teacher" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="date" class="form-label">date:</label> 
                <InputDate id="date" @bind-Value="Lesson.date" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Lesson.date" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="time" class="form-label">time:</label> 
                <InputDate id="time" @bind-Value="Lesson.time" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Lesson.time" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="spent" class="form-label">spent:</label> 
                <InputCheckbox id="spent" @bind-Value="Lesson.spent" class="form-check-input" /> 
                <ValidationMessage For="() => Lesson.spent" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/lessons">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Lesson Lesson { get; set; } = default!;

    protected override void OnInitialized() => Lesson ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddLesson()
    {
        using var context = DbFactory.CreateDbContext();
        context.Schedule.Add(Lesson);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/lessons");
    }
}
