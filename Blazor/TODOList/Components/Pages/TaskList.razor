@page "/tasklist"
@rendermode InteractiveServer
@using Models;

<h3>TaskList</h3>
<div class="statistics">
	<h5>Всего: @tasklist.Count</h5>
	<h5>Выполено: @tasklist.Where(task => task.DONE == true).ToArray().Length</h5>
	<h5>Осталось: @tasklist.Where(task => task.DONE == false).ToArray().Length</h5>
</div>

<hr />

<input type="text" @bind="description"/>
<input type="button" value="Добавить" @onclick="addTask" class="btn btn-primary" />
<input type="button" value="Удалить выполненные" @onclick="() => tasklist.RemoveAll(task => task.DONE)" class="btn btn-primary" />
<input type="button" value="Очистить" @onclick="() => tasklist.Clear()" class="btn btn-danger" />
<hr />

<ul>
	@foreach (TODO item in tasklist)
	{
		<li>
			<input type="checkbox" id="@item.Description" @bind="@item.DONE"/>
			<label for="@item.Description">@item.Description</label>
		</li>
	}
</ul>

@code {
	//List<Models.TODO> tasklist = [];
	List<Models.TODO> tasklist =
	[
		new TODO { Description = "Полить цветы" },
		new TODO { Description = "Покормить кота" },
		new TODO { Description = "Сделать дмоашку" }
	];
	string description = "";

	void addTask()
	{
		TODO item = new TODO { Description = description };
		if (tasklist.Contains(item))
			return;
		tasklist.Add(item);
		description = "";
	}

}
