
<fieldset>
<legend>LearningDays</legend>

	<ul>
		@for (int i = 0; i < 7; i++)
		{
		<li>
			<input type="checkbox" id="@Week.DAYNAMES[i]" @bind="@days[i]" />
			<label for="@Week.DAYNAMES[i]">@Week.DAYNAMES[i]</label>
		</li>
		}
	</ul>
</fieldset>

@code 
{
	bool[] days = new bool[7];

	[Parameter]
	public Academy.Models.Group Group { get; set; }

	void Extract()
	{
		int mask = Group.learning_days ?? 0;
		for (int i= 0; i < 7; i++)
		{
			days[i] = ((mask >> i) & 1) == 1;
		}
	}

	protected override void OnInitialized()
	{
		Extract();
	}
}
