@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Blazor</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Factorial">
                <span class="bi factorial-nav-menu" aria-hidden="true"></span> Factorial
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Power">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Power
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Fibonacci">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Fibonacci
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Numerics">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Numerics
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" @onclick="() => expand = !expand">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Cripto
            </NavLink>
        </div>
        @if (expand)
        {

        <div class="submenu">

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Bitcoin">
                    <span class="bi bitcoin-nav-menu" aria-hidden="true"></span> Bitcoin
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Litecoin">
                    <span class="bi litecoin-nav-menu" aria-hidden="true"></span> Litecoin
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Atom">
                    <span class="bi atom-nav-menu" aria-hidden="true"></span> Atom
                </NavLink>
            </div>
        </div>
        }
    </nav>
</div>
@code
{
    bool expand;
}

