@page "/disciplines/details"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    @if (discipline is null)
    {
        <p><em>Loading...</em></p>
    }
    else 
    {
        <div class="controls">
            <h2>@discipline.discipline_name</h2>
            <a href="@($"/disciplines/edit?discipline_id={discipline.discipline_id}")" class="btn btn-primary">Редактировать</a>
        </div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">discipline_name</dt>
            <dd class="col-sm-10">@discipline.discipline_name</dd>
            <dt class="col-sm-2">number_of_lessons</dt>
            <dd class="col-sm-10">@discipline.number_of_lessons</dd>
        </dl>
        <div>
            <a href="@($"/disciplines")">Back to List</a>
        </div>
        <h3>Преподаватели @(discipline.TDR.Count)</h3>
        <ul>
            @foreach(TeachersDisciplinesRelation tdr in discipline.TDR)
            {
                <li>@tdr.Teacher.full_name</li>
            }
        </ul>
    }
</div>

@code {
    private Discipline? discipline;

    [SupplyParameterFromQuery]
    private int discipline_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        discipline = await context.Disciplines.Include(d => d.TDR).ThenInclude(tdr => tdr.Teacher).FirstOrDefaultAsync(m => m.discipline_id == discipline_id);

        if (discipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
