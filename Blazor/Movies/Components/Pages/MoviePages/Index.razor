@page "/movies"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Movies.Models
@implements IAsyncDisposable
@inject IDbContextFactory<MoviesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<div class="controls">
    <h1>Index</h1>

    <p>
        <a href="movies/create" class="btn btn-primary">Create New</a>
    </p>
</div>

<QuickGrid Class="table" Items="context.Movie">
    <PropertyColumn Property="movie => movie.Title" />
    <PropertyColumn Property="movie => movie.ReleaseDate" />
    @* <PropertyColumn Property="movie => movie.URL" />
    <PropertyColumn Property="movie => movie.Poster" /> *@

    <TemplateColumn Context="movie">
        <a href="@($"movies/edit?id={movie.id}")">Edit</a> |
        <a href="@($"movies/details?id={movie.id}")">Details</a> |
        <a href="@($"movies/delete?id={movie.id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private MoviesContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
