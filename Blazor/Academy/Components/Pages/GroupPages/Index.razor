@page "/groups"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<div>
    <h1>Группы</h1>

    <a href="groups/create" class="btn btn-primary">Добавить</a>
</div>

<QuickGrid Class="table" Items="context.Groups.Include(g => g.Direction).Include(g => g.Students)">
    <PropertyColumn Property="group => group.group_name" Sortable="true" />
    <PropertyColumn Property="group => group.Students.Count" Sortable="true"/>
    <PropertyColumn Property="group => group.start_date" Sortable="true" />
    <PropertyColumn Property="group => group.start_time" Sortable="true" />
    @* <PropertyColumn Property="group => new Week((int)(group.learning_days ?? 0))" Sortable="true" /> *@
    <TemplateColumn Context="group" Title="Учебные дни" Sortable="true" SortBy="@sortByLearningDays">
        @(new Week((int)(group.learning_days ?? 0)))
    </TemplateColumn>
	<PropertyColumn Property="group => group.Direction.direction_name" />

    <TemplateColumn Context="group">
        <a href="@($"groups/edit?group_id={group.group_id}")">Edit</a> |
        <a href="@($"groups/details?group_id={group.group_id}")">Details</a> |
        <a href="@($"groups/delete?group_id={group.group_id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyContext context = default!;
    GridSort<Group> sortByLearningDays = GridSort<Group>.ByAscending(g => g.learning_days);

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
